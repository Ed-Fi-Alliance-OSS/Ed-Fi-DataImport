{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DataImport Web (mssql-shared)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/DataImport.Web/bin/Debug/net10.0/DataImport.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/DataImport.Web",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "AppSettings__DatabaseEngine": "SqlServer",
                "ConnectionStrings__defaultConnection": "Data Source=(local);Initial Catalog=EdFi_DataImport;Trusted_Connection=True;TrustServerCertificate=True;"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
